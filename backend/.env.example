APP_ENV=development
APP_BASE_URL=http://localhost:8000
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=INFO
TIMEZONE=Asia/Kolkata

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Secret/service-role key: required for Supabase Storage uploads and user invites (server-side only)
SUPABASE_SERVICE_ROLE_KEY=
# Direct connection (IPv6) or Supabase pooler URL. URL-encode special characters in the password (@ -> %40).
DATABASE_URL=

# Leave empty to auto-select: razorpay when keys are present, otherwise mock (mock is refused in production)
PAYMENT_PROVIDER=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# "meta" (WhatsApp Cloud API, default) or "fast2sms" (WhatsApp through Fast2SMS).
WHATSAPP_PROVIDER=meta
# meta: Cloud API access token. fast2sms: the Fast2SMS API key.
WHATSAPP_ACCESS_TOKEN=
# WhatsApp Business number id (Meta, or shown in the Fast2SMS WhatsApp panel)
WHATSAPP_PHONE_NUMBER_ID=
# Approved templates. meta: template names (default fee_reminder / payment_success).
# fast2sms: the numeric message_id of each approved template (both required).
WHATSAPP_TEMPLATE_FEE_REMINDER=
WHATSAPP_TEMPLATE_PAYMENT_SUCCESS=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Meta app secret, used to verify X-Hub-Signature-256 on WhatsApp webhooks
WHATSAPP_APP_SECRET=

# Only "fast2sms" is implemented today
SMS_PROVIDER=
SMS_PROVIDER_API_KEY=
SMS_SENDER_ID=

EMAIL_API_KEY=

# Leave empty to auto-select: supabase when SUPABASE_SERVICE_ROLE_KEY is set, otherwise local disk
STORAGE_BACKEND=
LOCAL_STORAGE_DIR=.storage
STUDENT_PHOTO_BUCKET=student-photos
ID_CARD_BUCKET=id-cards
RECEIPT_BUCKET=receipts
ACADEMY_ASSETS_BUCKET=academy-assets

# Optional TTF fonts so PDFs can render non-Latin text (e.g. DejaVuSans.ttf)
PDF_FONT_PATH=
PDF_FONT_BOLD_PATH=

SCHEDULER_INTERVAL_SECONDS=60
LOGIN_RATE_LIMIT_PER_MINUTE=10
